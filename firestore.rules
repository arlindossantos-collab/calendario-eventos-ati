rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedAti() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ati\\.pe\\.gov\\.br$');
    }

    function isAdminRecord(email) {
      return verifiedAti()
        && request.auth.token.email == email
        && exists(/databases/$(database)/documents/administradores/$(email))
        && get(/databases/$(database)/documents/administradores/$(email)).data.ativo == true;
    }

    function isEditor() {
      return verifiedAti()
        && exists(/databases/$(database)/documents/administradores/$(request.auth.token.email))
        && get(/databases/$(database)/documents/administradores/$(request.auth.token.email)).data.ativo == true
        && (
          get(/databases/$(database)/documents/administradores/$(request.auth.token.email)).data.role == 'editor'
          || get(/databases/$(database)/documents/administradores/$(request.auth.token.email)).data.role == 'admin'
        );
    }

    function isAdmin() {
      return verifiedAti()
        && exists(/databases/$(database)/documents/administradores/$(request.auth.token.email))
        && get(/databases/$(database)/documents/administradores/$(request.auth.token.email)).data.ativo == true
        && get(/databases/$(database)/documents/administradores/$(request.auth.token.email)).data.role == 'admin';
    }

    match /eventos/{eventId} {
      // Somente eventos publicados são públicos.
      allow get: if resource.data.publicado == true || isEditor();
      // Consultas públicas precisam conter publicado == true.
      allow list: if isEditor() || request.query.where('publicado', '==', true);

      allow create: if isEditor()
        && request.resource.data.title is string
        && request.resource.data.start is string
        && request.resource.data.end is string
        && request.resource.data.publicado is bool;

      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    match /inscricoes/{registrationId} {
      // Inscrição pública, sem login. Não permite leitura pública de dados pessoais.
      allow create: if
        request.resource.data.eventId is string
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.presente == false
        && exists(/databases/$(database)/documents/eventos/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/eventos/$(request.resource.data.eventId)).data.publicado == true;

      allow get, list: if isEditor();
      allow update, delete: if isEditor();
    }

    match /administradores/{email} {
      // Um usuário só consegue consultar seu próprio cadastro após autenticação.
      allow get: if isAdminRecord(email);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin()
        && email.matches('^[^@\\s]+@ati\\.pe\\.gov\\.br$')
        && request.resource.data.nome is string
        && request.resource.data.role in ['editor', 'admin']
        && request.resource.data.ativo is bool;
    }

    match /auditoria/{auditId} {
      allow read: if isAdmin();
      allow create: if isEditor();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
