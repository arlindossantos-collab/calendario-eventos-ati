rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function verifiedAtiEditor() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ati\\.pe\\.gov\\.br$')
        && firestore.exists(/databases/(default)/documents/administradores/$(request.auth.token.email))
        && firestore.get(/databases/(default)/documents/administradores/$(request.auth.token.email)).data.ativo == true
        && (
          firestore.get(/databases/(default)/documents/administradores/$(request.auth.token.email)).data.role == 'editor'
          || firestore.get(/databases/(default)/documents/administradores/$(request.auth.token.email)).data.role == 'admin'
        );
    }

    match /event-cards/{eventId}/{fileName} {
      // Os cards publicados são baixáveis pelo público.
      allow read: if true;

      // Upload/alteração/exclusão somente para editor/admin autorizado.
      allow write: if verifiedAtiEditor()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if verifiedAtiEditor();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
